# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
FRED_API_KEY=
ALPHAVANTAGE_API_KEY=
DESK_BASIC_AUTH_USER=ahmed
DESK_BASIC_AUTH_PASS=change-me
TZ=Europe/Berlin
# Where SQLite, inbox, archive and backups live (a volume in Docker).
DESK_DATA_DIR=./data
# Execution: paper (default). ibkr / alpaca are stubs until phase 5 and additionally need DESK_LIVE=1.
DESK_BROKER=paper
# DESK_LIVE=1
# Weekly digest (Monday 07:30 Berlin). Without SMTP settings the digest is written to data/digests/.
# DESK_DIGEST_TO=you@example.com
# DESK_SMTP_HOST=smtp.example.com
# DESK_SMTP_PORT=587
# DESK_SMTP_USER=
# DESK_SMTP_PASS=
# Optional Claude-written paragraph on each decision (template reasoning is always stored).
# DESK_LLM_REASONING=1
# SEC EDGAR asks for a User-Agent that names you and an e-mail address (Form 4 feed, brief 8d)
DESK_EDGAR_USER_AGENT=desk you@example.com
