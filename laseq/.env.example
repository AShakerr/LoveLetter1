# SQLite file for local dev. Switch to Postgres (and the pg adapter) for production.
DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies (min 32 chars). Generate: openssl rand -hex 32
AUTH_SECRET="change-me-to-a-long-random-string-please-32chars"

# OTP delivery. "console" prints codes to the server log (dev). Later: "whatsapp" or "sms".
OTP_PROVIDER="console"

# Phone number that gets the ADMIN role on first login (Egyptian format, e.g. +201001234567)
ADMIN_PHONE="+201000000000"
